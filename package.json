{
  "name": "tzmeet-monorepo",
  "private": true,
  "version": "0.6.0",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @tzmeet/web test:e2e",
    "dev": "pnpm --filter @tzmeet/web dev",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "check:package": "node scripts/verify-package.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e && pnpm check:package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "homepage": "https://zahidhasann88.github.io/tzmeet/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zahidhasann88/tzmeet.git"
  },
  "bugs": {
    "url": "https://github.com/zahidhasann88/tzmeet/issues"
  }
}
