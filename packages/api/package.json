{
  "name": "@tzmeet/api",
  "version": "0.6.0",
  "description": "REST API for finding meeting times across time zones and working with cron schedules",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/zahidhasann88/tzmeet/tree/main/packages/api#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zahidhasann88/tzmeet.git",
    "directory": "packages/api"
  },
  "bugs": {
    "url": "https://github.com/zahidhasann88/tzmeet/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "start": "node dist/node.js",
    "dev:worker": "wrangler dev --ip 0.0.0.0",
    "worker:dry-run": "wrangler deploy --dry-run --outdir .wrangler/bundle",
    "worker:size": "node scripts/bundle-size.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "1.6.3",
    "@scalar/hono-api-reference": "0.12.14",
    "@tzmeet/core": "workspace:*",
    "hono": "^4.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "ical.js": "^2.2.1",
    "wrangler": "4.153.0"
  }
}
